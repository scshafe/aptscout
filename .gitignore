# The owner's apartments, rents, rankings and notes never enter git
# (docs/brief.md): they are runtime data outside the repository. data/ holds
# only its README; downloaded datasets (OSM extracts, CTA GTFS) stay local.
/data/*
!/data/README.md
/state/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite3
*.dump
.env
.env.*
# names only, never values (tests/test_repository.py checks it)
!/deploy/stack/.env.example
*.log

# Python (repository tests)
__pycache__/
*.py[cod]
.venv/

# Node / web builds
node_modules/
dist/
build/
.cache/

.DS_Store

# DRAFT of the runner-lane deploy workflow, for the owner session to review and
# place at .github/workflows/deploy.yml once the runner is registered. The agent
# does not add it there: SERVICE-02 keeps ci.yml deploy-free, and a deploy
# workflow is reviewed by hand. Labels, paths and the env file are placeholders.
name: Deploy
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: deploy
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: [self-hosted, aptscout]          # OWNER: the runner's labels
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1   # v7.0.1, as in ci.yml
        with:
          persist-credentials: false
      - name: Verify
        run: ./scripts/verify
      - name: Build and restart the stack
        run: |
          docker compose -f deploy/compose.yml --env-file "$APTSCOUT_ENV_FILE" up -d --build server jobs
      - name: Health check
        run: |
          for i in $(seq 1 30); do
            curl -fsS http://127.0.0.1:8000/healthz && exit 0
            sleep 2
          done
          exit 1

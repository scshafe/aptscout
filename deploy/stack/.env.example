# Names only, for humans: no tool reads this file. Values are placed on the host
# by the owner's provisioning (`stack env-set aptscout NAME`), never committed.
TS_AUTHKEY=                   # one-off, single-use, tagged tag:aptscout (first join only)
APTSCOUT_PUBLIC_URL=          # https://aptscout.<tailnet>
APTSCOUT_OIDC_ISSUER=         # https://id.<tailnet>
APTSCOUT_OIDC_HOST=           # id.<tailnet>, pinned in the sidecar's /etc/hosts
ID_TAILNET_IP=                # the id node's tailscale IPv4
APTSCOUT_OIDC_CLIENT_ID=      # the Pocket ID client: aptscout (confidential, PKCE)
APTSCOUT_OIDC_CLIENT_SECRET=
APTSCOUT_ALLOWED_SUBJECTS=    # the owner's OIDC subject (comma-separated for more)
APTSCOUT_SESSION_SECRET=      # generated on the host (openssl rand -hex 32)
# APTSCOUT_IMAGE is written by each deploy (the pin)

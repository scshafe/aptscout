#!/usr/bin/env bash
# The repository's one verify command (dev.toml [verify]): the repository and
# server tests (standard library unittest, in a virtualenv with the server's
# pinned requirements), then the web type check and build. CI runs the same
# command.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -x .venv/bin/python ] || ! .venv/bin/python -c "import fastapi" 2>/dev/null; then
    python3 -m venv .venv
    .venv/bin/pip install -q -r server/requirements.txt
fi
.venv/bin/python -B -m unittest discover -s tests -t . -v

if [ -f web/package.json ]; then
    (cd web && npm ci --no-audit --no-fund && npm run check && npm test && npm run build)
fi
